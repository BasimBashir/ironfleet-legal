{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','moot_gate_hook.py'),run_name='__main__')\"",
            "statusMessage": "IronFleet moot gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ironfleet_begin_run$",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','capture_session.py'),run_name='__main__')\""
          }
        ]
      }
    ]
  }
}
